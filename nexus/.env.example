# Server-side only. Never expose these values with a VITE_ prefix.
OPENROUTER_API_KEY=

# Optional direct provider keys for standalone chat modes
NEXUS_OPENAI_API_KEY=
NEXUS_GEMINI_API_KEY=
NEXUS_GROQ_API_KEY=
NEXUS_MISTRAL_API_KEY=
NEXUS_KIMI_API_KEY=

# Optional search providers
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Team model overrides (OpenRouter model IDs)
NEXUS_TEAM_ARCHITECT_MODEL=anthropic/claude-sonnet-4
NEXUS_TEAM_RESEARCHER_MODEL=google/gemini-2.5-flash
NEXUS_TEAM_CRITIC_MODEL=deepseek/deepseek-chat
NEXUS_TEAM_SYNTHESIS_MODEL=openai/gpt-5
